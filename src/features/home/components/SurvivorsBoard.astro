---
// Los mejores tiempos de cada dificultad, en formato de registro mecanografiado.
import type { GameBoard, ScoreRow } from '@/features/games/types';
import { formatTime } from '@/features/games/lib/scores';

interface Props { slug: string; boards: { board: GameBoard; rows: ScoreRow[] }[] }
const { slug, boards } = Astro.props;
---

<section class="survivors" aria-labelledby="survivors-title">
  <div class="survivors__wrap">
    <div class="survivors__head">
      <h2 id="survivors-title" class="survivors__title">Lograron salir</h2>
      <p class="survivors__intro">Los tiempos más rápidos para escapar de Lima. Termina el juego con tu sesión iniciada y tu nombre entra al registro.</p>
    </div>

    <div class="survivors__cols">
      {boards.map(({ board, rows }) => (
        <div class="survivors__col">
          <h3 class="survivors__board">{board.label}</h3>
          {rows.length === 0 ? (
            <p class="survivors__empty">Nadie ha escapado todavía.</p>
          ) : (
            <ol class="survivors__list">
              {rows.slice(0, 3).map((r) => (
                <li>
                  <span class="survivors__pos">{r.pos}.</span>
                  <span class="survivors__name">{r.name}</span>
                  <span class="survivors__time">{formatTime(r.time_ms)}</span>
                  <span class="survivors__rank" title={`Rango ${r.rank}`}>{r.rank}</span>
                </li>
              ))}
            </ol>
          )}
        </div>
      ))}
    </div>

    <a href={`/juegos/${slug}`} class="survivors__link">Ver el marcador completo</a>
  </div>
</section>

<style>
  .survivors {
    background: linear-gradient(#07080a, #050505);
    color: #e2d2b0;
    padding: 0 0 clamp(4rem, 9vw, 7rem);
  }
  .survivors__wrap { width: min(100% - 2rem, 76rem); margin: 0 auto; }
  .survivors__head {
    display: grid; gap: 1rem 3rem; align-items: end;
    grid-template-columns: auto minmax(0, 30rem);
    margin-bottom: 2.5rem;
  }
  .survivors__title {
    font-family: Anton, Impact, sans-serif; font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1; text-transform: uppercase; margin: 0;
  }
  .survivors__intro { font-family: Georgia, serif; line-height: 1.6; color: rgba(226, 210, 176, .78); margin: 0; }
  .survivors__cols { display: grid; gap: 2rem; grid-template-columns: repeat(3, 1fr); }
  .survivors__board {
    font-family: Georgia, serif; font-size: 1.25rem; font-weight: 700; margin: 0 0 .9rem;
    padding-bottom: .6rem; border-bottom: 1px solid rgba(200, 160, 80, .45);
  }
  .survivors__list { list-style: none; padding: 0; margin: 0; font-family: 'Special Elite', 'Courier New', monospace; }
  .survivors__list li {
    display: grid; grid-template-columns: 1.6rem minmax(0, 1fr) auto 1.4rem; gap: .6rem; align-items: baseline;
    padding: .55rem 0; border-bottom: 1px dashed rgba(226, 210, 176, .12);
  }
  .survivors__pos { color: #8a806c; }
  .survivors__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .survivors__time { color: #fff; }
  .survivors__rank { color: #c8a050; text-align: right; }
  .survivors__empty { font-family: 'Special Elite', 'Courier New', monospace; color: #8a806c; margin: 0; }
  .survivors__link {
    display: inline-block; margin-top: 2.5rem; font-family: Georgia, serif; color: #e2d2b0;
    text-decoration: underline; text-decoration-color: #c8a050; text-underline-offset: .35em;
  }
  .survivors__link:hover { color: #fff; }
  .survivors__link:focus-visible { outline: 2px solid #c8a050; outline-offset: 4px; }

  @media (max-width: 860px) {
    .survivors__head { grid-template-columns: 1fr; }
    .survivors__cols { grid-template-columns: 1fr; }
  }
</style>
