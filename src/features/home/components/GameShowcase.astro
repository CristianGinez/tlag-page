---
// Escenas reales de Lima Infecta presentadas como fotos de evidencia del expediente.
const figs = [
  { src: '/img/juegos/lima-infecta/plaza.jpg', place: 'Plaza San Martín', note: 'Primer contacto. La fogata es lo único que alumbra.' },
  { src: '/img/juegos/lima-infecta/capon.jpg', place: 'Calle Capón, Barrio Chino', note: 'Algo camina entre los faroles rojos.' },
  { src: '/img/juegos/lima-infecta/comisaria.jpg', place: 'Comisaría Central', note: 'Refugio, o eso parecía.' },
  { src: '/img/juegos/lima-infecta/catacumbas.jpg', place: 'Catacumbas, osario', note: 'Bajo la ciudad no hay luz eléctrica.' },
];
const facts = [
  'Cámaras fijas al estilo de los survival horror clásicos.',
  'Juegas con teclado, mando o la pantalla táctil del celular.',
  'Tu partida se guarda en la nube y sigue en cualquier dispositivo.',
];
---

<section class="evidence" aria-labelledby="evidence-title">
  <div class="evidence__wrap">
    <h2 id="evidence-title" class="evidence__title">Lo que dejó la noche</h2>

    <div class="evidence__grid">
      {figs.map((f, i) => (
        <figure class={`evidence__fig evidence__fig--${i}`}>
          <img src={f.src} alt={`${f.place}, escena de Lima Infecta`} loading="lazy" decoding="async" />
          <figcaption>
            <span class="evidence__num">Fig. {i + 1}</span> {f.place}. {f.note}
          </figcaption>
        </figure>
      ))}
      <ul class="evidence__facts">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .evidence {
    background: #07080a;
    color: #e2d2b0;
    padding: clamp(4rem, 9vw, 7rem) 0;
  }
  .evidence__wrap { width: min(100% - 2rem, 76rem); margin: 0 auto; }
  .evidence__title {
    font-family: Anton, Impact, sans-serif;
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1;
    text-transform: uppercase;
    margin: 0 0 2.5rem;
  }
  .evidence__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(12, 1fr);
  }
  .evidence__fig { margin: 0; }
  .evidence__fig img {
    display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    filter: brightness(1.35) contrast(1.05);
    border: 1px solid rgba(226, 210, 176, .18);
  }
  .evidence__fig figcaption {
    margin-top: .7rem;
    font-family: 'Special Elite', 'Courier New', monospace;
    font-size: .88rem;
    line-height: 1.5;
    color: #a89a80;
  }
  .evidence__num { color: #c8a050; }
  .evidence__fig--0 { grid-column: 1 / span 8; grid-row: span 2; }
  .evidence__fig--1 { grid-column: 9 / span 4; }
  .evidence__fig--2 { grid-column: 9 / span 4; }
  .evidence__fig--3 { grid-column: 1 / span 7; }
  .evidence__facts {
    list-style: none; padding: 0;
    margin: 0;
    grid-column: 9 / span 4;
    align-self: center;
    display: grid; gap: 1.4rem;
    font-family: Georgia, serif;
    font-size: 1.02rem;
    line-height: 1.6;
    color: rgba(226, 210, 176, .82);
  }
  .evidence__facts li { border-top: 1px solid rgba(200, 160, 80, .35); padding-top: .9rem; }

  @media (max-width: 860px) {
    .evidence__fig--0, .evidence__fig--1, .evidence__fig--2, .evidence__fig--3 { grid-column: 1 / -1; grid-row: auto; }
    .evidence__facts { grid-column: 1 / -1; margin-top: 1rem; }
  }
</style>
