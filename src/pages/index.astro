---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/layouts/Navbar.astro';
import Footer from '@/layouts/Footer.astro';
import HeroSection from '@/shared/components/HeroSection.astro';
import NewsFeedSection from '@/features/news/components/NewsFeedSection.astro';
import ConnectDiscordCTA from '@/features/auth/components/ConnectDiscordCTA.astro';
import AwardsHighlight from '@/features/awards/components/AwardsHighlight.astro';
import LeagueHighlight from '@/features/parsec-league/components/LeagueHighlight.astro';
import TeamSection from '@/features/community/components/TeamSection.astro';
import LimaInfectaHero from '@/features/home/heroes/LimaInfectaHero.astro';
import GameShowcase from '@/features/home/components/GameShowcase.astro';
import SurvivorsBoard from '@/features/home/components/SurvivorsBoard.astro';
import BotCard from '@/features/home/components/BotCard.astro';
import { getGame, getLeaderboard } from '@/features/games/lib/gamesData';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// Evento actual del home: lanzamiento de Lima Infecta.
// Para volver al home de comunidad (o pasar a otro evento), cambia FEATURED_SLUG o el hero de abajo.
const FEATURED_SLUG = 'lima-infecta';
const game = await getGame(FEATURED_SLUG);
const boards = game
  ? await Promise.all((game.boards ?? []).map(async (board) => ({ board, rows: await getLeaderboard(game.slug, board.id) })))
  : [];
const normal = boards.find((b) => b.board.id === 'normal') ?? boards[0];
const record = normal?.rows[0] ?? null;

---

<Layout
  title={game ? `${game.title} — TeamLag` : 'TeamLag — La comunidad oficial de LAGartovich'}
  description={game ? 'Survival horror de cámaras fijas en el Centro de Lima. Juega gratis en el navegador.' : 'Comunidad argentina de videojuegos y stream. LAG Awards, Parsec League, streams en vivo y más.'}
  image={game ? 'https://www.tlag.online/img/juegos/lima-infecta/portada.jpg' : 'https://res.cloudinary.com/dkjaq3i9p/image/upload/v1768785502/PORTADA_vzoqne.jpg'}
>
  <Navbar />
  <main class="bg-[#050505] min-h-screen">
    {game ? (
      <>
        <LimaInfectaHero game={game} record={record} recordBoard={normal?.board.label ?? ''} />
        <GameShowcase />
        {boards.length > 0 && <SurvivorsBoard slug={game.slug} boards={boards} />}
      </>
    ) : (
      <HeroSection />
    )}
    <NewsFeedSection />
    {game && <BotCard />}
    <ConnectDiscordCTA />

    <!-- Divisor -->
    <div class="container mx-auto px-4 md:px-6">
      <div class="h-px bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>
    </div>

    <AwardsHighlight />

    <!-- Divisor -->
    <div class="container mx-auto px-4 md:px-6">
      <div class="h-px bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>
    </div>

    <LeagueHighlight />

    <!-- Divisor -->
    <div class="container mx-auto px-4 md:px-6">
      <div class="h-px bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>
    </div>

    <TeamSection />
  </main>
  <Footer />
</Layout>

<script>
  // Redirect Discord OAuth errors back to /perfil so the user sees the message
  const p = new URLSearchParams(window.location.search);
  const errCode = p.get('error_code') ?? new URLSearchParams(window.location.hash.slice(1)).get('error_code');
  if (errCode) {
    window.location.replace(`/perfil?discord_error=${encodeURIComponent(errCode)}`);
  }

  // Scroll reveal — Intersection Observer para todas las secciones
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08 }
  );

  document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
</script>

<style>
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal-on-scroll.revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>
