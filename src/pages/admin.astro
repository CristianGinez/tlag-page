---
import Layout from '../layouts/Layout.astro';
import Navbar from '../layouts/Navbar.astro';
import Footer from '../layouts/Footer.astro';
import { sendChangelogToDiscord } from '../features/admin/lib/discord';
import { getCategories, EVENT_ID_2025 } from '../features/awards/lib/awardsData';
import { getSupabase } from '../features/auth/lib/supabase';
import { getBadgeCatalog } from '../features/achievements/lib/achievementsData';
const adminCategories = await getCategories(EVENT_ID_2025);
const badgeCatalog = await getBadgeCatalog();

// Si es un POST (click al botón), enviamos el mensaje
if (Astro.request.method === 'POST') {
    try {
        const data = await Astro.request.formData();
        const version = data.get('version') as string;
        const notes = data.get('notes') as string;
        const imageUrl = data.get('imageUrl') as string;
        
        // Convertimos el texto del textarea en array de cambios
        const changesArray = notes.split('\n').filter(line => line.trim() !== '');
        
        await sendChangelogToDiscord(
            version,
            changesArray,
            imageUrl ? imageUrl : undefined // Si está vacío, enviamos undefined
        );
        const ssrSupabase = getSupabase(Astro);
        await ssrSupabase.from('site_changelog').insert({
          version,
          title: `Actualización v${version}`,
          body: changesArray.join('\n'),
          type: 'update',
          image: imageUrl || null,
        });
    } catch (e) {
        console.error("Error al enviar:", e);
    }
}
---

