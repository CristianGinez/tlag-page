# Supabase
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Gemini
GEMINI_API_KEY=

# Admin
PUBLIC_ADMIN_EMAIL=

# Upstash Redis (crear database gratis en upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Seguridad interna
INTERNAL_INVALIDATE_SECRET=

# Convex (deployment del bot de Discord)
PUBLIC_CONVEX_URL=
# NUNCA exponer en cliente — solo server-side
CONVEX_DEPLOY_KEY=

# Juegos (orígenes; en local: http://localhost:4321 y http://127.0.0.1:4321)
PUBLIC_SITE_ORIGIN=
PUBLIC_GAMES_ORIGIN=
# Requerida por las API routes de servidor (VIPs, badges, juegos admin)
SUPABASE_SERVICE_ROLE_KEY=
